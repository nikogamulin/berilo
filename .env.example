# Copy to .env and fill in. NEVER commit .env.
# Each user supplies their own key(s). Only one provider is required.

# OpenAI (default provider — cheapest models that do the job)
OPENAI_API_KEY=

# Anthropic (optional alternative provider)
ANTHROPIC_API_KEY=

# Defaults (override per-run with CLI flags)
BOOKWORM_TRANSLATION_MODEL=gpt-5-mini
BOOKWORM_JUDGE_MODEL=gpt-5-mini
BOOKWORM_TARGET_LANG=sl
