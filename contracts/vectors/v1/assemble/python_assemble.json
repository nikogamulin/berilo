          },
          {
            "id": "62679f22f4cac93106a1aea6a4939f3f3be08e38",
            "type": "heading",
            "text": "Raven 0 se dvigne na 1",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 3,
            "heading_level": 0
          },
          {
            "id": "2b72ac95e8f87a325d9353c3262b019578852232",
            "type": "paragraph",
            "text": "Uravnotezeno <em>poudarjeno</em> besedilo",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 4,
            "heading_level": null
          },
          {
            "id": "2217261b91912d7d83daea6d8f291a605e680b31",
            "type": "paragraph",
            "text": "Ugnezdeno <strong><em>oboje</em></strong> tukaj",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 5,
            "heading_level": null
          },
          {
            "id": "54081ba0fde1ef2ba776beb30b605ff343aaf4b4",
            "type": "paragraph",
            "text": "Velike crke <EM>se pomanjsajo</EM> nazaj",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 6,
            "heading_level": null
          },
          {
            "id": "06434546c9313f734ba543032018504b12e2304e",
            "type": "paragraph",
            "text": "Nezaprto <em>ubeži cel segment",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 7,
            "heading_level": null
          },
          {
            "id": "000aa3dba5bcd497add1c29bc8644a449ea16add",
            "type": "paragraph",
            "text": "Neujemajoce <em>ubeži</strong> cel segment",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 8,
            "heading_level": null
          },
          {
            "id": "a9de52cd350c196c553fa16c0d278d41641e4c55",
            "type": "paragraph",
            "text": "Odvecni zapiralnik</em> ubeži cel segment",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 9,
            "heading_level": null
          },
          {
            "id": "e17391f3367823e37b8934b86b5ff67c6a7e2f6d",
            "type": "paragraph",
            "text": "Veljaven <em>par</em> nato odvecni</strong> zapiralnik",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 10,
            "heading_level": null
          },
          {
            "id": "0cbfc953edd4c97ead791a290a4e1e9fd481593a",
            "type": "paragraph",
            "text": "Neubrani znaki: 5 > 3 in \"narekovaji\" in 'apostrofi'",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 11,
            "heading_level": null
          },
          {
            "id": "76f8501eaa7e2c16cef36930e764ce715d70161c",
            "type": "paragraph",
            "text": "Ubrani znaki: AT&T in a < b",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 12,
            "heading_level": null
          },
          {
            "id": "e705653c428f72e045ea052c35af46f975c35b55",
            "type": "list_item",
            "text": "Prva postavka",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 13,
            "heading_level": null
          },
          {
            "id": "8e9cf15904bae708f8d0cf83da3e5c0b11638730",
            "type": "list_item",
            "text": "Druga postavka",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 14,
            "heading_level": null
          },
          {
            "id": "65c42e8d7a25c9be33811521d19f97250ba255aa",
            "type": "paragraph",
            "text": "Odstavek prekine seznam",
            "chapter_index": 0,
            "chapter_title": "Prvo poglavje",
            "position": 15,
            "heading_level": null
          },
          {
            "id": "f30fbd3e7b9aaaf308c1d53145cbd5d4712e32d8",
            "type": "list_item",
