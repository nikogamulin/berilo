# Template for android/keystore.properties (gitignored — never commit the real file).
#
# 1. Generate a release keystore once (Supervisor-held secret, not part of this repo):
#      keytool -genkeypair -v -keystore release.keystore -alias berilo \
#        -keyalg RSA -keysize 2048 -validity 10000
# 2. Copy this file to android/keystore.properties and fill in real values.
# 3. storeFile is resolved relative to android/ (this file's directory).
#
# Without android/keystore.properties, `./gradlew assembleRelease` falls back
# to debug signing (see app/build.gradle.kts) so local/CI builds still work.

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=berilo
keyPassword=CHANGE_ME
