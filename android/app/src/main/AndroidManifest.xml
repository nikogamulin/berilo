<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- S2.3: LLM dictionary/interpretation/translation calls go straight to the
         user's own OpenAI/Anthropic account over HTTPS; no other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BeriloApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Berilo"
        android:supportsRtl="true">
        <!-- allowBackup=false is load-bearing for R7 (Rubric): Auto Backup would
             otherwise ship EncryptedSharedPreferences' encrypted blob off-device in a
             backup extract. Keep false even though the encrypted values themselves are
             unreadable without the Keystore-held master key — defense in depth. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Berilo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".reader.ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Berilo.Reader" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Berilo" />

        <activity
            android:name=".annotations.NotebookActivity"
            android:exported="false"
            android:theme="@style/Theme.Berilo" />

        <!-- S3.2: Clerk sign-in and cloud-sync status. -->
        <activity
            android:name=".sync.ui.AccountActivity"
            android:exported="false"
            android:theme="@style/Theme.Berilo" />

        <!-- B7: import a source-language EPUB, see what translating it costs, confirm, watch it
             run. Reached from the library top bar — the one path from gesture to a paid run. -->
        <activity
            android:name=".ui.translate.TranslateActivity"
            android:exported="false"
            android:theme="@style/Theme.Berilo" />

        <!-- S2.6: streams the notebook's Markdown export file to the share-sheet target
             (e.g. Obsidian) without granting a world-readable file:// Uri. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
