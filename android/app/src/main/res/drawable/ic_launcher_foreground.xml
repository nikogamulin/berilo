        android:fillColor="#FFFFFF"
        android:pathData="M54,34.5 C47.5,29.5 38.5,27.5 29.5,27.5 C26.5,27.5 24.2,27.8 22,28.3 L22,73.2 C24.2,72.7 26.5,72.5 29.5,72.5 C38.5,72.5 47.5,74.5 54,79.2 Z" />
    <!-- right page, a shade warmer so the gutter reads without an outline -->
    <path
        android:fillColor="#F4EDE4"
        android:pathData="M54,34.5 C60.5,29.5 69.5,27.5 78.5,27.5 C81.5,27.5 83.8,27.8 86,28.3 L86,73.2 C83.8,72.7 81.5,72.5 78.5,72.5 C69.5,72.5 60.5,74.5 54,79.2 Z" />

