        android:fillColor="#FFFFFF"
        android:pathData="M64.2,27.6 L71.3,27.6 L71.3,48.6 L67.75,44.4 L64.2,48.6 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M65.6,27.6 L69.9,27.6 L69.9,45.4 L67.75,42.8 L65.6,45.4 Z" />
