<!-- Themed-icon layer (Android 13+). The launcher tints this single-colour
     silhouette with the user's wallpaper palette, so it must read as one solid
     shape: page fills are dropped and the book is described by its outline,
     gutter, and ribbon alone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- book body: both pages as one outline -->
    <path
        android:fillColor="#000000"
        android:pathData="M54,34.5 C47.5,29.5 38.5,27.5 29.5,27.5 C26.5,27.5 24.2,27.8 22,28.3 L22,73.2 C24.2,72.7 26.5,72.5 29.5,72.5 C38.5,72.5 47.5,74.5 54,79.2 C60.5,74.5 69.5,72.5 78.5,72.5 C81.5,72.5 83.8,72.7 86,73.2 L86,28.3 C83.8,27.8 81.5,27.5 78.5,27.5 C69.5,27.5 60.5,29.5 54,34.5 Z" />

    <!-- gutter knocked out so the two pages stay readable when tinted flat -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52.4,35.6 L55.6,35.6 L55.6,78.4 L52.4,78.4 Z" />

    <!-- ribbon, knocked out of the right page then restated as a notch -->
