<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window background before Compose takes over. E-ink first: true
        white background, true black text (docs/design_guidelines.md).
    -->
    <style name="Theme.Berilo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/berilo_paper</item>
        <item name="android:statusBarColor">@color/berilo_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
        Reader-only theme. Readium's EpubNavigatorFragment inflates AppCompat
        widgets, which require an AppCompat (or descendant) activity theme at
        runtime; the DayNight parent tracks the system light/dark setting while
        the reflowable content colors are driven by EpubPreferences.
    -->
    <style name="Theme.Berilo.Reader" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/berilo_paper</item>
    </style>
</resources>
